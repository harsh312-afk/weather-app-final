{
  "name": "weather-app-final",
  "version": "2.0.0",
  "description": "Modern, feature-rich Weather Forecast and Atmospheric Dashboard with real-time conditions, hourly & 5-day forecasts, interactive weather maps, AQI, UV tracker, and ambient particle effects.",
  "main": "src/script.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build": "npm run build:css",
    "test": "node --test tests/*.test.js",
    "start": "npx serve ."
  },
  "keywords": [
    "weather",
    "weather-app",
    "forecast",
    "leaflet-maps",
    "tailwindcss",
    "javascript",
    "glassmorphism"
  ],
  "author": "Harsh Gautam",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}
